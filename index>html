<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Abdelrahman Alaa | Data Analyst & Agentic AI</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0b1120;
            color: #f8fafc;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* Navigation */

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(11, 17, 32, 0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #1e293b;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
        }

        .logo span {
            color: #38bdf8;
        }

        .nav-links {
            display: flex;
            gap: 28px;
            list-style: none;
        }

        .nav-links a {
            color: #cbd5e1;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #38bdf8;
        }

        /* General */

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 0 20px;
        }

        section {
            padding: 100px 0;
        }

        .section-title {
            font-size: 36px;
            margin-bottom: 45px;
            text-align: center;
        }

        .section-title span {
            color: #38bdf8;
        }

        /* Hero */

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 80px;
        }

        .hero-content {
            max-width: 750px;
        }

        .hero-small {
            color: #38bdf8;
            font-size: 18px;
            margin-bottom: 15px;
        }

        .hero h1 {
            font-size: 64px;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #38bdf8;
        }

        .hero h2 {
            font-size: 28px;
            color: #cbd5e1;
            margin-bottom: 20px;
        }

        .hero p {
            color: #94a3b8;
            font-size: 18px;
            max-width: 680px;
            margin-bottom: 30px;
        }

        .buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 13px 24px;
            border-radius: 8px;
            border: 1px solid #38bdf8;
            transition: 0.3s;
            font-weight: bold;
        }

        .btn-primary {
            background: #38bdf8;
            color: #0b1120;
        }

        .btn-primary:hover {
            background: transparent;
            color: #38bdf8;
        }

        .btn-secondary {
            color: #38bdf8;
        }

        .btn-secondary:hover {
            background: #38bdf8;
            color: #0b1120;
        }

        /* About */

        .about {
            background: #0f172a;
        }

        .about-content {
            max-width: 800px;
            margin: auto;
            text-align: center;
        }

        .about-content p {
            color: #cbd5e1;
            font-size: 18px;
            margin-bottom: 15px;
        }

        /* Skills */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .skill-card {
            background: #111827;
            border: 1px solid #1e293b;
            border-radius: 12px;
            padding: 25px;
            transition: 0.3s;
        }

        .skill-card:hover {
            transform: translateY(-5px);
            border-color: #38bdf8;
        }

        .skill-card h3 {
            color: #38bdf8;
            margin-bottom: 12px;
        }

        .skill-card p {
            color: #94a3b8;
        }

        /* Projects */

        .projects {
            background: #0f172a;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .project-card {
            background: #111827;
            border: 1px solid #1e293b;
            border-radius: 14px;
            padding: 28px;
            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-7px);
            border-color: #38bdf8;
        }

        .project-number {
            color: #38bdf8;
            font-size: 14px;
            font-weight: bold;
        }

        .project-card h3 {
            font-size: 23px;
            margin: 12px 0;
        }

        .project-card p {
            color: #94a3b8;
            margin-bottom: 18px;
        }

        .tech {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }

        .tech span {
            background: #1e293b;
            color: #cbd5e1;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 13px;
        }

        .project-link {
            color: #38bdf8;
            font-weight: bold;
        }

        /* Contact */

        .contact-content {
            text-align: center;
            max-width: 700px;
            margin: auto;
        }

        .contact-content p {
            color: #94a3b8;
            font-size: 18px;
            margin-bottom: 30px;
        }

        .contact-links {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        /* Footer */

        footer {
            border-top: 1px solid #1e293b;
            padding: 25px;
            text-align: center;
            color: #64748b;
        }

        /* Mobile */

        @media (max-width: 700px) {

            .nav-links {
                display: none;
            }

            .hero h1 {
                font-size: 42px;
            }

            .hero h2 {
                font-size: 22px;
            }

            .section-title {
                font-size: 30px;
            }
        }
    </style>
</head>

